{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run GUI App (all rounds)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Web Dashboard Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--web"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run CLI Batch (Round 2, headless)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_server.py",
            "args": ["--round", "2", "--input", "${workspaceFolder}/Input/Students.xlsx", "--headless"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}