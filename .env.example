# =============================================================================
# NEXUS AUTOMATION HUB — environment template
# Copy to .env.local for local runs. On Vercel, add these in
# Project Settings → Environment Variables, then redeploy.
# =============================================================================

# Public URL of THIS dashboard (used in health output / setup guidance).
# Local:  http://localhost:3080
# Vercel: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3080

# Shared registration secret. MUST be identical in:
#   - this dashboard environment
#   - the value entered in START_AUTOMATION_HUB.bat on every runner PC
# It authenticates registration/heartbeat only. Each PC then receives its own
# random control token, which is what protects poll/claim/update/cancel.
RUNNER_SECRET_TOKEN=change-me-to-a-long-random-string

# Supabase (required on Vercel for persistence across cold starts).
# Use the service_role key; it stays server-side and bypasses RLS.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional Supabase anon key (only used as a fallback if the service role key
# is absent, e.g. fully local development).
# SUPABASE_ANON_KEY=

# Optional: disable manual pairing codes entirely.
# DISABLE_PAIRING=1

# Local development only. Vercel sets PORT automatically — do not add it there.
# PORT=3080
